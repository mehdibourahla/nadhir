# Shared secret the Cloudflare scheduler presents to /api/internal/source-jobs/run
NADHIR_CRON_SECRET=""

# Broadcast delivery (server-side). Unset means broadcasts are stored but never
# sent, and /status reports the source degraded.
# FIREBASE_SERVICE_ACCOUNT is the whole service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT=""
TELEGRAM_BOT_TOKEN=""

# Model calls (server-side): citizen-report screening, DGPC and ITA extraction and the
# civil agent all go to Nadhir's home model gateway (gpt-6-luna on the ChatGPT plan,
# infrastructure/home-m2). Unset means those items wait as pending and the run reports
# "model gateway gateway_unset"; a citizen report shows its tapped category without text.
NADHIR_GATEWAY_URL=""
NADHIR_GATEWAY_ACCESS_CLIENT_ID=""
NADHIR_GATEWAY_ACCESS_CLIENT_SECRET=""
# Operator alerts: your Telegram chat id; the watchdog DMs it on state transitions.
NADHIR_OPERATOR_CHAT_ID=""
