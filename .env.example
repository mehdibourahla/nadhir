# Server-side only. Bypasses RLS — never expose to the browser and never commit.
SUPABASE_SERVICE_ROLE_KEY=""

# Ingestion credentials (server-side)
FIRMS_MAP_KEY=""
EUMETSAT_CONSUMER_KEY=""
EUMETSAT_CONSUMER_SECRET=""

# Shared secret the Cloudflare scheduler presents to /api/internal/source-jobs/run
NADHIR_CRON_SECRET=""

# Broadcast delivery (server-side). Unset means broadcasts are stored but never
# sent, and /status reports the source degraded.
# FIREBASE_SERVICE_ACCOUNT is the whole service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT=""
TELEGRAM_BOT_TOKEN=""

# Model calls (server-side): citizen-report screening, DGPC and ITA extraction and the
# civil agent all go to Nadhir's home model gateway (gpt-6-luna on the ChatGPT plan,
# infrastructure/home-m2). Unset means those items wait as pending and the run reports
# "model gateway gateway_unset"; a citizen report shows its tapped category without text.
NADHIR_GATEWAY_URL=""
NADHIR_GATEWAY_ACCESS_CLIENT_ID=""
NADHIR_GATEWAY_ACCESS_CLIENT_SECRET=""
# Automatic LLM API fallback (server-side): used automatically when the primary
# home gateway is unset, unreachable, paused, rate-limited, timed out, or returning 5xx.
# Supported providers: mistral (EU default), openai, openrouter, openai-compatible, anthropic.
# Optional: LLM_FALLBACK_TIMEOUT_MS, LLM_FALLBACK_MAX_RETRIES (0..2), LLM_FALLBACK_HEADERS (JSON),
# or LLM_FALLBACK_CHAIN (JSON array of ordered fallback providers, takes precedence over single vars).
LLM_FALLBACK_PROVIDER=""
LLM_FALLBACK_API_URL=""
LLM_FALLBACK_API_KEY=""
LLM_FALLBACK_MODEL=""
# Operator alerts: your Telegram chat id; the watchdog DMs it on state transitions.
NADHIR_OPERATOR_CHAT_ID=""
