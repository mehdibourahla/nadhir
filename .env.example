# Ingestion credentials (server-side)
FIRMS_MAP_KEY=""
EUMETSAT_CONSUMER_KEY=""
EUMETSAT_CONSUMER_SECRET=""

# Shared secret the Cloudflare scheduler presents to /api/internal/source-jobs/run
NADHIR_CRON_SECRET=""

# Broadcast delivery (server-side). Unset means broadcasts are stored but never
# sent, and /status reports the source degraded.
# FIREBASE_SERVICE_ACCOUNT is the whole service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT=""
TELEGRAM_BOT_TOKEN=""

# Official text sources (server-side). Unset means the DGPC bulletin lines the
# template parser cannot resolve are logged as unresolved instead of extracted.
# OPENROUTER_MODEL overrides the default (google/gemini-2.5-flash); it must support
# json_schema response_format.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
# Operator alerts: your Telegram chat id; the watchdog DMs it on state transitions.
NADHIR_OPERATOR_CHAT_ID=""
